# KOTONE が生成する MPD 設定。
# install.sh が @MUSIC_DIR@ / @DATA_DIR@ を実際のパスへ置換します。
#
# 既存の設定は /etc/mpd.conf.kotone-backup に退避されています。
# 手で編集する場合は install.sh --no-mpd-config を使ってください。

music_directory     "@MUSIC_DIR@"
playlist_directory  "@DATA_DIR@/mpd/playlists"
db_file             "@DATA_DIR@/mpd/tag_cache"
state_file          "@DATA_DIR@/mpd/state"
sticker_file        "@DATA_DIR@/mpd/sticker.sql"

user                "mpd"
bind_to_address     "localhost"
port                "6600"

# 家庭内 LAN 限定運用のため、MPD 自体は localhost にのみ bind する。
# 外部からの操作は KOTONE のバックエンド経由になる（要件 4.3）。

log_file            "syslog"
log_level           "notice"

auto_update         "no"
# ライブラリの更新は KOTONE 側のスキャンから明示的に指示する。
# 常時監視は SSD/USB メディアのスピンアップやログの肥大を招くため無効にする。

# ---------------------------------------------------------------- 再生品質

# ギャップレス再生のための設定（要件 3.1）
gapless_mp3_playback "yes"

# ReplayGain は使わない。ラウドネス補正は KOTONE のバックエンドが
# SQLite に保持した計測値をもとに setvol で動的に適用する（要件 3.1）。
replaygain          "off"

# 音量はソフトウェアミキサーで扱う。
# ラウドネス補正が setvol を使うため、ハードウェアミキサーだと
# DAC 側のカーブに依存して補正が不正確になる。
mixer_type          "software"

# 曲間の無音を詰めない（原盤どおりに再生する）
audio_buffer_size   "4096"

# ---------------------------------------------------------------- 出力

audio_output {
    type            "alsa"
    name            "USB DAC"

    # ここを実機の DAC に合わせて変更してください。
    #   aplay -l   で確認できます（例: "hw:1,0"）
    # 既定では ALSA の default を使います。
    # device        "hw:1,0"

    # ビットパーフェクト再生のため、MPD 側でのリサンプリングを行わない
    auto_resample   "no"
    auto_format     "no"
    auto_channels   "no"

    # DSD をネイティブで送るか DoP (DSD over PCM) で送るか。KOTONE が設定
    # 「DSD の出力方式」に合わせて実行時に切り替える（outputset）ので、
    # ここは no のままにしてください。
    dop             "no"

    # DSD には、このソフトウェア音量が効かない（素通しになる。MPD 0.24.4 で
    # 実測）。DSD をそのまま送る曲のあいだ、KOTONE は音量を 100 に固定する。
    mixer_type      "software"
}

audio_output {
    type            "alsa"
    name            "USB DAC (PCM)"

    # DSD を PCM に変換して送るための 2 つ目の出力。上の「USB DAC」と同じ
    # 機器を指すので、device は必ず同じにしてください。
    # device        "hw:1,0"

    auto_resample   "no"
    auto_format     "no"
    auto_channels   "no"

    # 音量より前で DSD を PCM にする（下の filter を参照）。出力側の
    # format / allowed_formats で PCM にすると、変換が音量より後ろになり、
    # 音量が効かないままになる。PCM の曲は 32bit に広げられるだけで値は
    # 変わらない（16bit・24bit とも、ずらしただけと一致することを実測）。
    filters         "dsd2pcm"

    mixer_type      "software"

    # 既定は無効。KOTONE が「DSD の出力方式」に合わせて USB DAC と切り替える。
    # 画面には出さず、「USB DAC」として扱う。
    enabled         "no"
}

audio_output {
    type            "alsa"
    name            "Bluetooth"

    # 「最後に接続した BT 機器」を自動で指す（bluez-alsa の既定）。
    # 機器を替えてもここを書き換える必要はない。
    device          "bluealsa"

    mixer_type      "software"

    # A2DP は 48kHz / 16bit までしか通らないので、変換を許可する。
    # USB DAC 側のビットパーフェクト設定とは別に指定している。
    auto_resample   "yes"
    auto_format     "yes"
    auto_channels   "yes"

    # 既定は無効。出力の切り替えは KOTONE の設定画面から行う。
    enabled         "no"
}

# HTTP ストリーミング等が必要になったらここに audio_output を追加します。

# ---------------------------------------------------------------- フィルタ

# 「USB DAC (PCM)」が使う。FFmpeg のフィルタは PCM しか受け付けないため、
# MPD が手前で DSD を PCM（DSD64 なら 352.8 kHz）に変換する。anull なので
# フィルタ自体は何もしない。
filter {
    plugin          "ffmpeg"
    name            "dsd2pcm"
    graph           "anull"
}

# ---------------------------------------------------------------- デコーダ

decoder {
    plugin          "ffmpeg"
    enabled         "yes"
}

input {
    plugin          "curl"
    enabled         "no"
}
